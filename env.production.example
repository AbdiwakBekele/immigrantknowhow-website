# Copy to .env.production on the server before `npm run build`.
# Must point at a Laravel hub that exposes /api/public/* (service-types, community, library, etc.).
# Also used by POST /webhooks/stripe to proxy Stripe events to the hub.

NEXT_PUBLIC_HUB_API_BASE_URL=https://hub.immigrantknowhow.com
NEXT_PUBLIC_HUB_ORIGIN=https://hub.immigrantknowhow.com
